<Window x:Class="TextLocator.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Help"
        Height="350" Width="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanMinimize"
        Icon="/Resource/App.ico"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- set foreground color of the textblock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#252526"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="12">

            <!-- orignal author -->
            <GroupBox Header="Original Author"
                      Margin="0,0,0,10"
                      BorderBrush="#2F7AE5"
                      BorderThickness="1"
                      Padding="8">
                <StackPanel Orientation="Vertical" Margin="0,2,0,0">
                    <TextBlock Text="Name: Lei Liu"   HorizontalAlignment="Left"/>
                    <TextBlock Text="Wechat: liulei901112" HorizontalAlignment="Left"/>
                    <TextBlock Text="Email: liulei901112@163.com" HorizontalAlignment="Left"/>
                    <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap">
            <Run Text="Github: " />
            <Hyperlink NavigateUri="https://github.com/liulei901112/TextLocator"
                       RequestNavigate="Hyperlink_RequestNavigate"
                       Foreground="#2F7AE5"
                       TextDecorations="{x:Null}">
                https://github.com/liulei901112/TextLocator
            </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- AI Assistant author -->
            <GroupBox Header="AI Assistant Author"
                      Margin="0,0,0,10"
                      BorderBrush="#2F7AE5"
                      BorderThickness="1"
                      Padding="8">
                <StackPanel Orientation="Vertical" Margin="0,2,0,0">
                    <TextBlock Text="Name: Jinshuo Liu" HorizontalAlignment="Left"/>
                    <TextBlock Text="Email: ucabius@ucl.ac.uk" HorizontalAlignment="Left"/>
                    <TextBlock Text="Supervisor: Prof. Dean Mohamedally &amp; Prof. Graham Roberts" HorizontalAlignment="Left"/>
                    <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap">
            <Run Text="Github: " />
            <Hyperlink NavigateUri="https://github.com/FierceWind1287/ai-textlocator"
                       RequestNavigate="Hyperlink_RequestNavigate"
                       Foreground="#2F7AE5"
                       TextDecorations="{x:Null}">
                https://github.com/FierceWind1287/ai-textlocator
            </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- textblock + two logos -->
            <Grid Margin="0,-10,0,0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- project title-->
                <TextBlock Grid.Column="0"
               Text="UCL IXN project- Collaboration with Intel"
               FontWeight="SemiBold"
               FontSize="14"
               Foreground="#444"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"
               Margin="0,0,8,0"/>
                

                <!-- ucl logo and intel logo-->
                <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                    <Image Source="/Resource/UCL_logo.png"
               Height="35" Stretch="Uniform"
               SnapsToDevicePixels="True"
               Margin="0,0,8,0"/>
                    <Image Source="/Resource/intel-logo-icon-png-svg.png"
               Height="70" Stretch="Uniform"
               SnapsToDevicePixels="True"/>
                </StackPanel>
            </Grid>



        </StackPanel>
    </Grid>
</Window>
