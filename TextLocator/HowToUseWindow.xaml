<Window x:Class="TextLocator.HowToUseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="How to Use TextLocator AI Assistant"
        Height="420" Width="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanMinimize"
        Icon="/Resource/App.ico">

    <Grid>
        <Border Margin="12" Padding="16" CornerRadius="10"
                Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1">
            <DockPanel LastChildFill="True">

                <!-- Header -->
                <TextBlock DockPanel.Dock="Top"
                           Text="How to Use"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#222" Margin="0,0,0,12"/>

                <!-- Two methods side-by-side -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Rows="1">
                        <!-- Method 1 : AI Search -->
                        <Border Margin="0,0,8,0" Padding="14"
                                Background="#FAFBFF" BorderBrush="#DDE3EE" BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Method 1 — AI Search (Recommended)"
                                           FontWeight="SemiBold" FontSize="16" Foreground="#1F2A44"
                                           Margin="0,0,0,8"/>
                                <Separator/>
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,6" Foreground="#444" FontSize="14">
                                    <Run Text="• Set the search area: "/><Run Text="Double-click the “Search Area” field at the bottom of the home screen, then choose folders."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#444" FontSize="14">
                                    <Run Text="• Enter your query: "/><Run Text="Type in the large search box, or tap the microphone to use voice input."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,0" Foreground="#444" FontSize="14">
                                    <Run Text="• Run the search: "/><Run Text="Click the “Search” button and wait for the AI results."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Method 2 : Classic Search -->
                        <Border Margin="8,0,0,0" Padding="14"
                                Background="#FAFBFF" BorderBrush="#DDE3EE" BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Method 2 — Classic Search"
                                           FontWeight="SemiBold" FontSize="16" Foreground="#1F2A44"
                                           Margin="0,0,0,8"/>
                                <Separator/>
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,6" Foreground="#444" FontSize="14">
                                    <Run Text="• Open the classic page: "/><Run Text="Click “Go to Classic Search” on the home screen."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#444" FontSize="14">
                                    <Run Text="• Search manually: "/><Run Text="Type your keywords in the classic search box and press Enter."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,0" Foreground="#444" FontSize="14"><Run Text="• Tip"/><Run Language="en" Text=" 1"/><Run Text=": "/><Run Text="Use filters on the classic page to narrow down results if needed."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,0" Foreground="#444" FontSize="14"><Run Text="• Tip"/><Run Language="en" Text=" 2"/><Run Text=": "/><Run Text="Click the “AI Search” button to return to AI assistant."/></TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </ScrollViewer>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Close" Width="84" Height="32" Click="Close_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
